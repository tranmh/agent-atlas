{
  "name": "agent-atlas-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright e2e suite for agent-atlas (runs against the docker-compose stack).",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "typecheck": "tsc --noEmit",
    "screenshots": "playwright test --project=screenshots",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.8",
    "typescript": "5.9.3"
  }
}
