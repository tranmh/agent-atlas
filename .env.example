# Copy to .env (`cp .env.example .env`). Host-side ports only; container ports are fixed.
GATEWAY_HOST_PORT=8000
GATEWAY_LLM_HOST_PORT=8100
GATEWAY_UI_HOST_PORT=15000
JAEGER_HOST_PORT=16686
WEB_HOST_PORT=3000
VISUALIZER_HOST_PORT=8095

# Agents: divide every scripted wait by this factor (2 = twice as fast). A run can override it.
SCRIPT_SPEED=1.0

# LLM agents call the gateway's LLM route, which forwards to Ollama on the host.
LLM_ENABLED=1
LLM_MODEL=qwen3:1.7b

# Event payloads larger than this are truncated in the event log.
EVENT_PAYLOAD_MAX_BYTES=16384
